{
    "openapi": "3.0.0",
    "info": {
        "title": "AI Website API Documentation",
        "description": "API documentation for AI Website backend service",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/auth/user/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login User",
                "operationId": "user.login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/App\\Http\\Requests\\Auth\\LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/App\\Http\\Resources\\AuthResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation or Authentication Error"
                    }
                }
            }
        },
        "/api/v1/auth/user/refresh-token": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Refresh Token",
                "operationId": "user.refresh",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/App\\Http\\Requests\\Auth\\RefreshTokenRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token Refreshed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/App\\Http\\Resources\\TokenResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid Refresh Token"
                    }
                }
            }
        },
        "/api/v1/auth/user/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register New User",
                "operationId": "user.register",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/App\\Http\\Requests\\Auth\\RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Registration Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/App\\Http\\Resources\\UserResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error"
                    }
                }
            }
        },
        "/api/v1/auth/user/resend-verification-email": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Resend Verification Email",
                "operationId": "user.resend-verification-email",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/App\\Http\\Requests\\Auth\\ResendVerificationEmailRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Verification Link Sent",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/App\\Http\\Resources\\MessageResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error"
                    }
                }
            }
        },
        "/api/v1/auth/user/email/verify/{id}/{hash}": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Verify Email",
                "operationId": "user.verify-email",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "hash",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Email Verified",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/App\\Http\\Resources\\MessageResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid Token"
                    }
                }
            }
        },
        "/api/v1/auth/user/forgot-password": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Forgot Password",
                "operationId": "user.forgot-password",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/App\\Http\\Requests\\Auth\\ForgotPasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password reset link emailed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/App\\Http\\Resources\\MessageResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/user/reset-password": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Reset Password",
                "operationId": "user.reset-password",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/App\\Http\\Requests\\Auth\\ResetPasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password Reset Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/App\\Http\\Resources\\MessageResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error"
                    }
                }
            }
        },
        "/api/v1/auth/user/change-password": {
            "put": {
                "tags": [
                    "Auth"
                ],
                "summary": "Change Password",
                "operationId": "user.change-password",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/App\\Http\\Requests\\Auth\\ChangePasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password Changed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/App\\Http\\Resources\\MessageResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/auth/user/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Logout",
                "operationId": "user.logout",
                "responses": {
                    "200": {
                        "description": "Logout Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/App\\Http\\Resources\\MessageResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/auth/social-providers": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "List available social login providers",
                "description": "List configured social providers so the frontend can render buttons dynamically.",
                "operationId": "user.social.providers",
                "responses": {
                    "200": {
                        "description": "Available providers"
                    }
                }
            }
        },
        "/api/v1/auth/user/social/{driver}/redirect": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login User with Social Redirect",
                "operationId": "user.social.redirect",
                "parameters": [
                    {
                        "name": "driver",
                        "in": "path",
                        "description": "Social Driver (google, facebook, github)",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Redirect URL generated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/App\\Http\\Resources\\SocialRedirectResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Provider error"
                    }
                }
            }
        },
        "/api/v1/auth/user/social/{driver}/callback": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login User with Social Callback",
                "operationId": "user.social.callback",
                "parameters": [
                    {
                        "name": "driver",
                        "in": "path",
                        "description": "Social Driver",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Social Login Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/App\\Http\\Resources\\AuthResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Authentication failed"
                    }
                }
            }
        },
        "/api/v1/videos": {
            "get": {
                "tags": [
                    "Videos"
                ],
                "summary": "List user videos",
                "operationId": "videos.index",
                "parameters": [
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated video list",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/VideoResource"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Videos"
                ],
                "summary": "Create a new video",
                "operationId": "videos.store",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StoreVideoRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Video created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/VideoResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/videos/{video}": {
            "get": {
                "tags": [
                    "Videos"
                ],
                "summary": "Get a single video",
                "operationId": "videos.show",
                "parameters": [
                    {
                        "name": "video",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Video detail",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/VideoResource"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Videos"
                ],
                "summary": "Update a video",
                "operationId": "videos.update",
                "parameters": [
                    {
                        "name": "video",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateVideoRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Video updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/VideoResource"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Videos"
                ],
                "summary": "Delete a video",
                "operationId": "videos.destroy",
                "parameters": [
                    {
                        "name": "video",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Video deleted"
                    },
                    "403": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "App\\Http\\Requests\\Auth\\ChangePasswordRequest": {
                "required": [
                    "current_password",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "current_password": {
                        "type": "string",
                        "format": "password",
                        "example": "OldPassword123!"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "NewPassword123!"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "format": "password",
                        "example": "NewPassword123!"
                    }
                },
                "type": "object"
            },
            "App\\Http\\Requests\\Auth\\ForgotPasswordRequest": {
                "required": [
                    "email"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "admin@example.com"
                    }
                },
                "type": "object"
            },
            "App\\Http\\Requests\\Auth\\LoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "admin@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password"
                    },
                    "remember": {
                        "type": "boolean",
                        "example": false,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "App\\Http\\Requests\\Auth\\RefreshTokenRequest": {
                "required": [
                    "refresh_token"
                ],
                "properties": {
                    "refresh_token": {
                        "type": "string",
                        "example": "def50200..."
                    }
                },
                "type": "object"
            },
            "App\\Http\\Requests\\Auth\\RegisterRequest": {
                "required": [
                    "name",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "john@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "Secret123!"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "format": "password",
                        "example": "Secret123!"
                    }
                },
                "type": "object"
            },
            "App\\Http\\Requests\\Auth\\ResendVerificationEmailRequest": {
                "required": [
                    "email"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "admin@example.com"
                    }
                },
                "type": "object"
            },
            "App\\Http\\Requests\\Auth\\ResetPasswordRequest": {
                "required": [
                    "token",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "token": {
                        "type": "string",
                        "example": "abc123token"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "admin@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "NewPassword123!"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "format": "password",
                        "example": "NewPassword123!"
                    }
                },
                "type": "object"
            },
            "App\\Http\\Resources\\AuthResource": {
                "required": [
                    "token",
                    "user"
                ],
                "properties": {
                    "token": {
                        "$ref": "#/components/schemas/App\\Http\\Resources\\TokenResource"
                    },
                    "user": {
                        "$ref": "#/components/schemas/App\\Http\\Resources\\UserResource"
                    }
                },
                "type": "object"
            },
            "App\\Http\\Resources\\MessageResource": {
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Operation successful"
                    }
                },
                "type": "object"
            },
            "App\\Http\\Resources\\SocialRedirectResource": {
                "required": [
                    "redirect_url",
                    "provider"
                ],
                "properties": {
                    "redirect_url": {
                        "type": "string",
                        "example": "https://accounts.google.com/o/oauth2/auth..."
                    },
                    "provider": {
                        "type": "string",
                        "example": "google"
                    }
                },
                "type": "object"
            },
            "App\\Http\\Resources\\TokenResource": {
                "required": [
                    "token_type",
                    "expires_in",
                    "expires_at",
                    "access_token",
                    "refresh_token"
                ],
                "properties": {
                    "token_type": {
                        "type": "string",
                        "example": "Bearer"
                    },
                    "expires_in": {
                        "type": "integer",
                        "example": 31536000
                    },
                    "expires_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2027-08-16T09:00:00.000000Z"
                    },
                    "access_token": {
                        "type": "string",
                        "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIs..."
                    },
                    "refresh_token": {
                        "type": "string",
                        "example": "def50200..."
                    }
                },
                "type": "object"
            },
            "App\\Http\\Resources\\UserResource": {
                "required": [
                    "id",
                    "name",
                    "email",
                    "created_at",
                    "updated_at"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "example": "9c3c6f1a-6df7-4b1e-b8eb-9d8e6c7d9a10"
                    },
                    "name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "john@example.com"
                    },
                    "email_verified_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-08-16T09:00:00.000000Z",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-08-16T09:00:00.000000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-08-16T09:00:00.000000Z"
                    }
                },
                "type": "object"
            },
            "StoreVideoRequest": {
                "required": [
                    "url"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "My Video",
                        "nullable": true
                    },
                    "description": {
                        "type": "string",
                        "example": "A sample video",
                        "nullable": true
                    },
                    "url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://example.com/video.mp4"
                    }
                },
                "type": "object"
            },
            "UpdateVideoRequest": {
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "My Video",
                        "nullable": true
                    },
                    "description": {
                        "type": "string",
                        "example": "A sample video",
                        "nullable": true
                    },
                    "url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://example.com/video.mp4"
                    }
                },
                "type": "object"
            },
            "VideoResource": {
                "required": [
                    "id",
                    "code",
                    "driver",
                    "url",
                    "user_id",
                    "views",
                    "created_at",
                    "updated_at"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "code": {
                        "type": "string",
                        "example": "aB3xK9mQ"
                    },
                    "title": {
                        "type": "string",
                        "nullable": true
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "extension": {
                        "type": "string",
                        "example": "mp4",
                        "nullable": true
                    },
                    "mime_type": {
                        "type": "string",
                        "example": "video/mp4",
                        "nullable": true
                    },
                    "driver": {
                        "type": "string",
                        "example": "direct"
                    },
                    "url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "file_size": {
                        "type": "integer",
                        "example": 0
                    },
                    "user_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "qualities": {
                        "type": "object",
                        "nullable": true
                    },
                    "views": {
                        "type": "integer",
                        "example": 0
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
